{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "font",
    "cursor",
    "terminal",
    "terminalfont",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk"
  ],
"logo": {
    "type": "kitty",
    "source": "~/.config/fastfetch/logo.png",
    "width": 50,
    "height": 18,
    "padding": {
        "top": 3,
        "right": 15,
	"left": 4
    }
},

}
